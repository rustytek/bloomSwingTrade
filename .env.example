# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# --- Admin Credentials ---
# Synced to the configured admin account on startup.
ADMIN_USER=admin
ADMIN_PASS=changeme

# --- Server ---
HOST=0.0.0.0
PORT=8443

# --- AI Provider ---
# Options: none | anthropic | openai | litellm
AI_PROVIDER=litellm
AI_API_KEY=
AI_MODEL=tooling_high   # LiteLLM tier alias, not a raw model name — see aiProxy/CLAUDE.md

# --- LiteLLM (OpenAI-compatible proxy — the only AI backend this app talks to) ---
LITELLM_URL=http://192.168.0.21:4000
LITELLM_API_KEY=your_litellm_virtual_key_for_this_user

# --- FRED API (free key at fred.stlouisfed.org) ---
# Enables Macro & Liquidity charts: M2, Fed Funds, 2yr/10yr yields, yield spread.
# Home Assistant add-on users should set this in the add-on Configuration tab
# as fred_api_key instead of editing this file inside the container.
FRED_API_KEY=your_fred_api_key_here

REPORT_MODEL=tooling_high   # daily report generation — LiteLLM tier alias
