# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# --- Initial Admin Credentials (first run only) ---
ADMIN_USER=admin
ADMIN_PASS=changeme

# --- Server ---
HOST=0.0.0.0
PORT=8443

# --- AI Provider ---
# Options: none | anthropic | openai
AI_PROVIDER=none
AI_API_KEY=
# Optional: override default model
# AI_MODEL=claude-opus-4-6   (for Anthropic)
# AI_MODEL=gpt-4o            (for OpenAI)
