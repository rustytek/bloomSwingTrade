{
  "name": "SwingTrader",
  "description": "Self-hosted swing trading screener — live market data via Yahoo Finance, technical indicators (RSI, MACD, BB, MA), watchlist & portfolio tracking, Fidelity CSV import, and optional AI analysis via LiteLLM/Ollama.",
  "version": "1.7.2",
  "slug": "swingtrader",
  "url": "https://github.com/rustytek/bloomSwingTrade",
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "init": "false",
  "boot": "auto",
  "webui": "[PROTO:ssl]://[HOST]:[PORT:8443]",
  "ports": {
    "8443/tcp": 8443
  },
  "ports_description": {
    "8443/tcp": "HTTPS Web UI"
  },
  "map": ["ssl:ro"],
  "options": {
    "secret_key": "change-me-to-a-random-32-char-string",
    "admin_user": "admin",
    "admin_pass": "changeme",
    "use_ha_ssl": false,
    "certfile": "fullchain.pem",
    "keyfile": "privkey.pem",
    "ai_provider": "litellm",
    "ai_api_key": "",
    "ai_model": "ollama/qwen3.5:9-mlx",
    "fred_api_key": "",
    "litellm_url": "http://192.168.0.21:4000",
    "litellm_api_key": "",
    "ollama_url": "http://192.168.0.21:11434",
    "ollama_model": "qwen3.5:9-mlx",
    "report_model": "ollama/qwen3.5:9-mlx"
  },
  "schema": {
    "secret_key": "str",
    "admin_user": "str",
    "admin_pass": "str",
    "use_ha_ssl": "bool",
    "certfile": "str",
    "keyfile": "str",
    "ai_provider": "list(none|anthropic|openai|ollama|litellm)",
    "ai_api_key": "str",
    "ai_model": "str",
    "fred_api_key": "str",
    "litellm_url": "str",
    "litellm_api_key": "str",
    "ollama_url": "str",
    "ollama_model": "str",
    "report_model": "str"
  }
}
