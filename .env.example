# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# --- Initial Admin Credentials (first run only) ---
ADMIN_USER=admin
ADMIN_PASS=changeme

# --- Server ---
HOST=0.0.0.0
PORT=8443

# --- AI Provider ---
# Options: none | anthropic | openai | ollama
AI_PROVIDER=ollama
AI_API_KEY=

# --- FRED API (free key at fred.stlouisfed.org) ---
FRED_API_KEY=your_fred_api_key_here

# --- FRED API (free key at fred.stlouisfed.org) ---
FRED_API_KEY=your_fred_api_key_here

# --- Ollama (local LLM) ---
OLLAMA_URL=http://192.168.10.21:11434
OLLAMA_MODEL=qwen35-moe:latest   # general chat / per-stock analysis
REPORT_MODEL=deepseek-r1:8b      # daily report generation (reasoning model)
