# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# --- Admin Credentials ---
# Synced to the configured admin account on startup.
ADMIN_USER=admin
ADMIN_PASS=changeme

# --- Server ---
HOST=0.0.0.0
PORT=8443

# --- AI Provider ---
# Options: none | anthropic | openai | ollama | litellm
AI_PROVIDER=litellm
AI_API_KEY=
AI_MODEL=ollama/qwen3.5:9-mlx

# --- LiteLLM (OpenAI-compatible proxy, can route to local Ollama) ---
# If LITELLM_URL is blank, the app falls back to OLLAMA_URL.
LITELLM_URL=http://192.168.0.21:4000
LITELLM_API_KEY=

# --- FRED API (free key at fred.stlouisfed.org) ---
# Enables Macro & Liquidity charts: M2, Fed Funds, 2yr/10yr yields, yield spread.
# Home Assistant add-on users should set this in the add-on Configuration tab
# as fred_api_key instead of editing this file inside the container.
FRED_API_KEY=your_fred_api_key_here

# --- Ollama (local LLM) ---
OLLAMA_URL=http://192.168.0.21:11434
OLLAMA_MODEL=qwen3.5:9-mlx   # general chat / per-stock analysis
REPORT_MODEL=ollama/qwen3.5:9-mlx      # daily report generation (reasoning model)
