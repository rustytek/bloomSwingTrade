{
  "name": "SwingTrader",
  "description": "Self-hosted swing trading screener — live market data via Yahoo Finance, technical indicators (RSI, MACD, BB, MA), watchlist & portfolio tracking, Fidelity CSV import, and optional AI analysis (Anthropic / OpenAI).",
  "version": "1.2.1",
  "slug": "swingtrader",
  "url": "https://github.com/rustytek/bloomSwingTrade",
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "init": "false",
  "boot": "auto",
  "webui": "[PROTO:ssl]://[HOST]:[PORT:8443]",
  "ports": {
    "8443/tcp": 8443
  },
  "ports_description": {
    "8443/tcp": "HTTPS Web UI"
  },
  "map": ["ssl:ro"],
  "options": {
    "secret_key": "change-me-to-a-random-32-char-string",
    "admin_user": "admin",
    "admin_pass": "changeme",
    "use_ha_ssl": false,
    "certfile": "fullchain.pem",
    "keyfile": "privkey.pem",
    "ai_provider": "none",
    "ai_api_key": "",
    "ai_model": ""
  },
  "schema": {
    "secret_key": "str",
    "admin_user": "str",
    "admin_pass": "str",
    "use_ha_ssl": "bool",
    "certfile": "str",
    "keyfile": "str",
    "ai_provider": "list(none|anthropic|openai)",
    "ai_api_key": "str",
    "ai_model": "str"
  }
}
